diff --git a/src/ledger.js b/src/ledger.js
index 514f4bc..a04b33e 100644
--- a/src/ledger.js
+++ b/src/ledger.js
@@ -19,4 +19,9 @@ function total(entries) {
   return entries.reduce((sum, entry) => sum + entry.cents, 0);
 }
 
-module.exports = { parseLine, readLedger, total };
+// Average entry, in whole cents.
+function average(entries) {
+  return Math.floor(total(entries) / entries.length);
+}
+
+module.exports = { parseLine, readLedger, total, average };
