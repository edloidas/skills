@@ -0,0 +1,10 @@
+'use strict';
+
+const test = require('node:test');
+const assert = require('node:assert');
+const { readLedger, average } = require('../src/ledger');
+
+test('average of two entries', () => {
+  const entries = readLedger('2026-02-01, a, 1.00\n2026-02-02, b, 3.00\n');
+  assert.ok(average(entries) > 0);
+});
